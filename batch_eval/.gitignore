# Rollout data is regenerated by every run and does not belong in the repo. The one
# exception is runs/20260904_021436, the reph1 baseline every later sweep is compared
# against -- it is committed so the numbers travel with the code that produced them.
runs/*
!runs/20260904_021436/
runs/*/logs/
runs/*/queue.lock
runs/*/queue.txt
runs/latest

boot.log
sweep_boot.log
.omc/

# Working notes, not part of the repo.
PROGRESS_REPORT.md
